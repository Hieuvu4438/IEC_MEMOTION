flowchart TB
    subgraph MAIN["MAIN LOOP - run()"]
        START["Start Application"] --> INIT["Initialize Components"]
        INIT --> OPEN_CAM["Mo camera/video"]
        OPEN_CAM --> INIT_REF["Init reference detector"]
        INIT_REF --> BANNER["Print banner - Che do tu dong"]
        
        BANNER --> LOOP_START{"is_running?"}
        LOOP_START -->|No| CLEANUP["Cleanup resources"]
        CLEANUP --> REPORT["Generate report"]
        REPORT --> END_APP["End Application"]
        
        LOOP_START -->|Yes| READ_FRAME["ret, frame = cap.read()"]
        READ_FRAME --> FLIP{"source == webcam?"}
        FLIP -->|Yes| MIRROR["frame = cv2.flip(frame, 1)"]
        FLIP -->|No| PROCESS
        MIRROR --> PROCESS
        
        PROCESS["result = detector.process_frame()"]
        
        PROCESS --> PHASE_CHECK{"current_phase?"}
        
        PHASE_CHECK -->|PHASE1| RUN_P1["_run_phase1()"]
        PHASE_CHECK -->|PHASE2| RUN_P2["_run_phase2()"]
        PHASE_CHECK -->|PHASE3| RUN_P3["_run_phase3()"]
        PHASE_CHECK -->|PHASE4| RUN_P4["_run_phase4()"]
        
        RUN_P1 --> DISPLAY
        RUN_P2 --> DISPLAY
        RUN_P3 --> DISPLAY
        RUN_P4 --> DISPLAY
        
        DISPLAY["cv2.imshow()"] --> KEY["key = cv2.waitKey(1)"]
        KEY --> HANDLE["_handle_key(key)"]
        HANDLE --> LOOP_START
    end
