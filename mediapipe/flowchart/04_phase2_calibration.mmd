flowchart TB
    subgraph PHASE2["PHASE 2: AUTOMATED CALIBRATION"]
        START["Start Phase 2"] --> GET_JOINT["Lay khop tu QUEUE index"]
        
        subgraph QUEUE["CALIBRATION_QUEUE - 6 khop"]
            Q1["1. LEFT_SHOULDER"]
            Q2["2. RIGHT_SHOULDER"]
            Q3["3. LEFT_ELBOW"]
            Q4["4. RIGHT_ELBOW"]
            Q5["5. LEFT_KNEE"]
            Q6["6. RIGHT_KNEE"]
        end
        
        GET_JOINT --> CHECK_ALL{"all_joints_calibrated?"}
        CHECK_ALL -->|Yes| SHOW_RESULT["Hien thi ket qua"]
        SHOW_RESULT --> WAIT_2S["Doi 2 giay"]
        WAIT_2S --> TRANSITION["_transition_to_phase3()"]
        
        CHECK_ALL -->|No| CHECK_COUNTDOWN{"is_countdown_active?"}
        CHECK_COUNTDOWN -->|No| START_COUNTDOWN["Bat dau countdown 5 giay"]
        START_COUNTDOWN --> SHOW_INSTRUCTION["Hien thi huong dan tu the"]
        
        CHECK_COUNTDOWN -->|Yes| COUNTDOWN_TICK["Hien thi so dem nguoc"]
        SHOW_INSTRUCTION --> COUNTDOWN_TICK
        
        COUNTDOWN_TICK --> COUNTDOWN_END{"Countdown het?"}
        COUNTDOWN_END -->|No| GET_JOINT
        COUNTDOWN_END -->|Yes| START_MEASURE["Bat dau do khop"]
        
        START_MEASURE --> COLLECTING["CalibrationState.COLLECTING"]
        COLLECTING --> COLLECT_ANGLE["Thu thap goc tu frame"]
        COLLECT_ANGLE --> FILTER["Median filter loai nhieu"]
        FILTER --> PROGRESS["Cap nhat progress bar"]
        
        PROGRESS --> MEASURE_DONE{"Calibrator COMPLETED?"}
        MEASURE_DONE -->|No| COLLECTING
        MEASURE_DONE -->|Yes| SAVE["Luu vao calibrated_joints"]
        SAVE --> NEXT["queue_index += 1"]
        NEXT --> GET_JOINT
    end
