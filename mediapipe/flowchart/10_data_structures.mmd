classDiagram
    class AppPhase {
        <<enumeration>>
        PHASE1_DETECTION
        PHASE2_CALIBRATION
        PHASE3_SYNC
        PHASE4_SCORING
        COMPLETED
    }
    
    class AppState {
        <<dataclass>>
        +current_phase: AppPhase
        +is_running: bool
        +is_paused: bool
        ---Phase 1---
        +pose_detected: bool
        +detection_stable_count: int
        +phase1_countdown_start: float
        +phase1_countdown_active: bool
        ---Phase 2---
        +calibration_queue_index: int
        +calibration_countdown_start: float
        +is_countdown_active: bool
        +is_calibrating_joint: bool
        +calibrated_joints: Dict
        +all_joints_calibrated: bool
        ---Phase 3---
        +sync_state: SyncState
        +motion_phase: str
        +user_angles_dict: Dict
        +target_angles_dict: Dict
        +joint_scores_dict: Dict
        +joint_weights: Dict
        +active_joints: List
        ---Phase 4---
        +rep_count: int
        +current_score: float
        +average_score: float
    }
    
    class JointType {
        <<enumeration>>
        LEFT_SHOULDER
        RIGHT_SHOULDER
        LEFT_ELBOW
        RIGHT_ELBOW
        LEFT_KNEE
        RIGHT_KNEE
    }
    
    class MemotionAppV2 {
        -_state: AppState
        -_detector: VisionDetector
        -_video_engine: VideoEngine
        -_sync_controller: MotionSyncController
        -_calibrator: SafeMaxCalibrator
        -_pain_detector: PainDetector
        -_scorer: HealthScorer
        -_logger: SessionLogger
        +run()
        +cleanup()
        -_run_phase1()
        -_run_phase2()
        -_run_phase3()
        -_run_phase4()
        -_handle_key()
        -_transition_to_phase2()
        -_transition_to_phase3()
        -_transition_to_phase4()
    }
    
    AppState --> AppPhase
    AppState --> JointType
    MemotionAppV2 --> AppState
